# Copy this file to .env and fill in real values. Nothing here needs a paid
# or production tier — see ../docs/environment-and-accounts.md for details
# on every value below, including where to get it and whether it's required.

# --- Database ---
# A real Postgres connection string. Free options: Supabase, Neon, Railway.
DATABASE_URL="postgresql://user:password@localhost:5432/arthur_os"

# --- Auth ---
# NEXTAUTH_SECRET: any long random string. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# --- Owner account (seeded by `npm run db:seed`) ---
# This is the ONLY login this app has in v1 — there is no public signup.
OWNER_EMAIL="derrick@example.com"
OWNER_PASSWORD="change-me-before-seeding"

# --- Stripe (test mode) ---
# From https://dashboard.stripe.com/test/apikeys — use a sk_test_... key.
# Real (live) keys are explicitly out of scope until production is authorized.
STRIPE_SECRET_KEY=""
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/stripe/webhook`)
# or the webhook endpoint you configure in the Stripe Dashboard (test mode).
STRIPE_WEBHOOK_SECRET=""

# --- Secure delivery links ---
# Any long random string, used to HMAC-sign delivery download tokens.
# Generate with: openssl rand -base64 32
DELIVERY_SECRET=""

# --- Email (defaults to test mode: logs to EmailEvent, sends nothing) ---
# Set to "resend" only once Derrick has explicitly approved real sending —
# see ../docs/environment-and-accounts.md and ../docs/owner-decisions-needed.md.
EMAIL_PROVIDER="test"
# Only used when EMAIL_PROVIDER=resend:
RESEND_API_KEY=""
EMAIL_FROM="Arthur <arthur@example.com>"

# --- Optional: upgrade the production stub to call Claude ---
# Not required for v1's default (deterministic template) behavior.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"
