# Copy this file to .env and fill in real values.

# --- Database ---
# A real Postgres connection string (use the connection *pooler* string, not
# the direct connection — the direct one is IPv6-only and fails from a lot
# of environments). Format:
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@localhost:5432/first_reply"

# --- Auth ---
# NEXTAUTH_SECRET: any long random string, used to encrypt session tokens.
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=""
# The URL this app is running at. http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"

# --- Email (powers the instant reply + follow-ups — the whole product) ---
# Get a key at https://resend.com/api-keys (free tier is enough to start)
RESEND_API_KEY=""
# Optional. Defaults to Resend's shared test sender, which works with no
# setup but looks less trustworthy to recipients. Once you verify your own
# domain in Resend, set this to something like "FirstReply <hello@yourdomain.com>".
FROM_EMAIL=""

# --- Cron ---
# Any long random string. Vercel Cron sends this back as a Bearer token so
# the follow-up endpoint can't be triggered by anyone else.
# Generate one with: openssl rand -base64 32
CRON_SECRET=""

# --- Billing (charges agents $129/month; mirrors revenue-os/app) ---
# BILLING_PROVIDER picks the DEFAULT used by the Stripe-specific webhook
# route and anywhere else that just wants "the" provider. It does NOT limit
# which providers agents can choose at checkout — the billing page shows a
# button for every provider below that's fully configured (isConfigured()
# in each provider file), so Stripe and Payhip can both be live at once.
BILLING_PROVIDER="stripe"
# From https://dashboard.stripe.com/apikeys — use a TEST key (sk_test_...)
# until you've explicitly decided to go live.
STRIPE_SECRET_KEY=""
# The recurring $129/month Price you create in the Stripe Dashboard for
# FirstReply (Product catalog > Add product > Recurring > monthly).
STRIPE_PRICE_ID=""
# From the Stripe CLI (`stripe listen --forward-to localhost:3000/api/billing/webhook`)
# or from the webhook endpoint you configure in the Stripe Dashboard
# (Developers > Webhooks > Add endpoint > /api/billing/webhook, events:
# customer.subscription.created / updated / deleted).
STRIPE_WEBHOOK_SECRET=""
# --- Payhip (optional second payment option) ---
# The "link" part of the direct checkout URL for the $129/month recurring
# product you create by hand in the Payhip dashboard (Payhip has no API for
# creating products) — e.g. if your checkout URL is
# https://payhip.com/buy?link=ean3D, this is "ean3D".
# See https://help.payhip.com/article/126-direct-checkout-link
PAYHIP_PRODUCT_LINK=""
# A random secret YOU generate (e.g. `openssl rand -base64 32`), used to
# secure the Payhip webhook. Put the SAME value in the webhook URL you
# configure in Payhip (Settings > Developer):
#   https://<your-domain>/api/billing/webhook/payhip?token=<this value>
# This is a URL-token check, not a signature check — see the long comment
# at the top of src/lib/billing/payhip.ts for why.
PAYHIP_WEBHOOK_TOKEN=""
# Also set your post-purchase redirect in Payhip's own dashboard (Account >
# Settings > Advanced Settings > Checkout Settings) to point back at
# /dashboard/billing?checkout=success — Payhip doesn't accept that per
# checkout the way Stripe does.
# "false" (default): everything works with no subscription — right for local
# dev and for proving the loop. "true": agents who haven't paid still get
# every lead saved and still get the "new lead" email, but the automatic
# reply + follow-ups to the lead stop until they subscribe. Flip to "true"
# only when you're ready to actually charge people.
BILLING_REQUIRED="false"
