// FirstReply data model.
// One Agent = one paying customer (a solo real estate agent). Each Agent has
// a unique public lead-capture link (/l/[agentId]) they share/embed; every
// Lead that comes in through it gets an instant auto-reply, then scheduled
// follow-ups until they respond or the agent marks the lead won/lost.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LeadStatus {
  NEW
  CONTACTED
  WON
  LOST
}

enum SubscriptionStatus {
  NONE
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum BillingProviderName {
  STRIPE
  PADDLE
  LEMONSQUEEZY
}

model Agent {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  leads        Lead[]
  subscription Subscription?
}

// Provider-agnostic billing record, one per Agent (the Agent *is* the
// paying customer). `provider` records which payment processor this agent
// is billed through; app code only talks to the BillingProvider interface
// (src/lib/billing/types.ts), so a second processor can be added later
// without changing this model. Same shape as revenue-os/app's Subscription.
model Subscription {
  id                     String              @id @default(cuid())
  agent                  Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId                String              @unique
  provider               BillingProviderName
  providerCustomerId     String?
  providerSubscriptionId String?
  status                 SubscriptionStatus  @default(NONE)
  priceId                String?
  currentPeriodEnd       DateTime?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
}

// instantReplyAt/touch2SentAt/touch3SentAt track the follow-up cadence
// directly on the lead rather than a separate event log — v1 only needs to
// know what's already been sent, not a full history.
model Lead {
  id             String     @id @default(cuid())
  agent          Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentId        String
  name           String
  email          String
  phone          String?
  message        String?    @db.Text
  status         LeadStatus @default(NEW)
  instantReplyAt DateTime?
  touch2SentAt   DateTime?
  touch3SentAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([agentId, status])
}
